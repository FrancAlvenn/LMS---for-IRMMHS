# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and must never be committed. This file (.env.example) IS
# committed — never put a real secret in it.

# --- Database (Phase 1) ---------------------------------------------------
# MongoDB Atlas connection string for this environment (dev/prod use
# different values — set this locally in .env.local, and again in the
# Vercel dashboard for production). Include the database name in the path,
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/irmmhs
MONGODB_URI=

# --- Auth (Phase 3 — next-auth v4) -----------------------------------------
# Session JWT signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical URL of this deployment. http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000
# Optional, not wired up yet: Google sign-in for staff accounts (students use
# admin-provisioned LRN-based credentials instead, per playbook D5 — no
# Google ID required for them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- File storage (later phase — logo, learner photos, attachments) ------
# Placeholder for whichever free/cheap object store gets picked (Vercel Blob,
# Cloudinary, S3-compatible). Fill in once Phase 6+/imagery work needs it.
BLOB_READ_WRITE_TOKEN=

# --- E2E testing (Phase 3) --------------------------------------------------
# Dev/test-only. The real seeded admin's password is randomly generated and
# shown once (see scripts/seed.ts) — not usable by an automated test. Set
# this locally and the seed script also creates a fixed-password "e2e-test"
# user the login E2E spec can use. Leave unset (e.g. in CI without secrets)
# and that spec skips itself instead of failing.
E2E_TEST_PASSWORD=
